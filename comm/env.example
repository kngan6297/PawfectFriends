# Communication App Environment Variables

# Main App Configuration
VITE_MAIN_APP_PORT=5173
VITE_COMMUNICATION_PORT=3000

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_MAIN_APP_URL=http://localhost:5173

# Conversation and Message Endpoints
VITE_CONVERSATIONS_ENDPOINT=/conversations
VITE_MESSAGES_ENDPOINT=/messages
VITE_PARTICIPANTS_ENDPOINT=/participants

# Zego ZIM Configuration
VITE_ZEGO_APP_ID=YOUR_ZEGO_APP_ID_HERE
VITE_ZEGO_SERVER_SECRET=YOUR_ZEGO_SERVER_SECRET_HERE

# Optional: Override default configuration
# VITE_ENABLE_CROSS_APP_NAVIGATION=true
# VITE_SHARED_STORAGE_KEY=pawfect-friends-auth

# File Sharing Configuration
VITE_MAX_FILE_SIZE=52428800
VITE_ALLOWED_FILE_TYPES=image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.json
VITE_IMAGE_COMPRESSION_QUALITY=0.8
VITE_THUMBNAIL_SIZES=150,300,600

# Group Chat Configuration
VITE_MAX_GROUP_CHAT_MEMBERS=1000
VITE_MAX_GROUP_CHAT_RULES=20
VITE_GROUP_CHAT_INVITE_EXPIRY_HOURS=72
VITE_ENABLE_EMERGENCY_ALERTS=true
VITE_ENABLE_MESSAGE_PINNING=true
