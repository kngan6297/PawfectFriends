# Frontend App Environment Variables
VITE_MAIN_APP_PORT=5173
VITE_COMMUNICATION_PORT=3000
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_ZEGO_APP_ID=YOUR_ZEGO_APP_ID_HERE

# ZegoCloud Configuration (for video calls and chat)
VITE_ZEGO_SERVER=wss://wss.zego.im/ws
VITE_ZEGO_SDK_LOG=0
# Note: Server secrets and tokens are handled securely by the backend only
# Frontend only needs the public app ID and server URL
# Webhook handling is done by the backend at /api/rtc/zim/webhooks/zim

# Logging Configuration
# Options: silent, error, warn, info, debug (default: info)
VITE_LOG_LEVEL=info

# Push Notifications
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# App Configuration
VITE_APP_NAME=PawfectFriends
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_PWA=true

# Development Configuration
VITE_DEV_MODE=false
VITE_MOCK_API=false

# External Services (Optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Content Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_SUPPORTED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Performance Configuration
VITE_CACHE_TTL=300000
VITE_DEBOUNCE_DELAY=300

# Accessibility Configuration
VITE_ENABLE_SCREEN_READER=true
VITE_HIGH_CONTRAST_MODE=false

# Internationalization
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,es,fr,de

# Error Reporting (Optional)
VITE_SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_ENVIRONMENT=development

# Testing Configuration
VITE_TEST_MODE=false
VITE_MOCK_SOCKET=false

# AI Service Configuration
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_AI_SERVICE_TIMEOUT=10000
VITE_AI_SERVICE_RETRIES=2
VITE_TOP_K_DEFAULT=6



