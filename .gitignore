# PawfectFriends - Root .gitignore
# This file ensures sensitive files are never committed to the repository

# Environment files (CRITICAL - Never commit these)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files (CRITICAL - May contain sensitive data)
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Generated files and storage (CRITICAL - May contain user data)
storage/
uploads/
contracts/
generated/
temp/
tmp/

# Database files
*.db
*.sqlite
*.sqlite3
dump.rdb

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.vite/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.temp
.cache/
.temp/

# Coverage directory
coverage/
*.lcov
.nyc_output

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.parcel-cache

# Storybook build outputs
.storybook-out

# Expo
.expo/
.expo-shared/
web-build/

# EAS
eas.json

# Local Netlify folder
.netlify

# Flipper
Flipper-Folly

# Watchman
.watchmanconfig

# Metro
.metro-health-check*

# Android/IntelliJ
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore

# BUCK
buck-out/
\.buckd/

# fastlane
*/fastlane/report.xml
*/fastlane/Preview.html
*/fastlane/screenshots
*/fastlane/test_output

# Bundle artifacts
*.jsbundle

# CocoaPods
/ios/Pods/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# macOS
*.pem

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Security: API Keys and Secrets (Additional protection)
*secret*
*key*
*token*
*credential*
*password.js
*password.json
*password.env
*password.txt
*password.key
*password.pem
*password.p12
*password.keystore
*private*

# Security: Backup files
*.bak
*.backup
*~

# Security: Configuration files that might contain secrets
config.json
secrets.json
credentials.json
