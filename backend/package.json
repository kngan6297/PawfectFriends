{
  "name": "pawfect-friends-backend",
  "version": "1.0.0",
  "description": "Backend API for PawfectFriends pet adoption platform",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm ci --only=production --no-audit --no-fund",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "fix:all": "npm run lint:fix && npm run format",
    "check:unused": "knip --config ../knip.json",
    "check:types": "knip --config ../knip.json --types",
    "migrate": "node scripts/run-migrations.js up",
    "migrate:rollback": "node scripts/run-migrations.js down",
    "migrate:status": "node scripts/run-migrations.js status",
    "check": "npm run check:unused && npm run check:types"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cli-progress": "^3.12.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.3",
    "envalid": "^8.1.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.3",
    "helmet": "^6.1.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "mongoose-paginate-v2": "^1.9.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.9",
    "p-limit": "^6.2.0",
    "puppeteer-core": "^21.11.0",
    "slugify": "^1.6.6",
    "ua-parser-js": "^2.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^5.0.0",
    "yup": "^1.1.1",
    "zego-express-engine-webrtc": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "knip": "^5.62.0",
    "nodemon": "^2.0.22",
    "prettier": "^3.5.3"
  }
}
